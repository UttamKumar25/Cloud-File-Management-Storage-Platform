PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/cloud_file_platform
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
S3_REGION=us-east-1
S3_BUCKET=cloud-files
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MAX_FILE_SIZE_MB=150
# Production only: public address of the deployed API (for example https://vaultly-api.onrender.com)
# PUBLIC_API_URL=https://your-api-domain.example
# Production only: comma-separated allowed frontend origins
# FRONTEND_URL=https://your-frontend-domain.example
